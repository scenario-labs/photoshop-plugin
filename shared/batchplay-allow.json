{
  "$comment": "The batchPlay allow-list for execute_batchplay (SPEC 6.6, MCP.md 4.7). Events are string ids. The toolkits of the Scenario Photoshop skills send make, set, select, autoCutout, newPlacedLayer, transform and placedLayerReplaceContents through Action Manager; the rest are the layer, selection, mask, channel, transform, canvas, adjustment and filter events SPEC 6.6 item 1 names. `refused_events` are refused even if someone adds them to `events` by mistake. `classes` are the reference classes accepted; `make_classes` are the classes a make may create with a class element and no form key. `get_strip` keys are removed from get results at any depth. Each entry needs a live test before release (SPEC 12.1).",
  "version": 1,
  "max_descriptors": 200,
  "max_result_bytes": 65536,
  "events": [
    "get",
    "make",
    "set",
    "select",
    "delete",
    "duplicate",
    "move",
    "transform",
    "show",
    "hide",
    "fill",
    "newPlacedLayer",
    "rasterizeLayer",
    "placedLayerReplaceContents",
    "mergeVisible",
    "mergeLayersNew",
    "canvasSize",
    "imageSize",
    "crop",
    "autoCutout",
    "colorRange",
    "expand",
    "contract",
    "feather",
    "smoothness",
    "intersectWith",
    "addTo",
    "subtractFrom",
    "inverse",
    "align",
    "applyImage",
    "minimum",
    "maximum",
    "displace",
    "curves",
    "levels",
    "hueSaturation",
    "colorBalance",
    "channelMixer",
    "invert",
    "desaturate",
    "equalize",
    "gaussianBlur",
    "highPass",
    "median",
    "addNoise",
    "unsharpMask",
    "smartSharpen",
    "offset"
  ],
  "refused_events": [
    "play",
    "AdobeScriptAutomation Scripts",
    "runScript",
    "scriptEvent",
    "syntheticFill",
    "syntheticGenerate",
    "generativeFill",
    "generativeExpand",
    "generativeUpscale",
    "removeTool",
    "open",
    "placeEvent",
    "save",
    "saveAs",
    "close",
    "quit",
    "splitChannels",
    "exportDocumentAs",
    "exportSelectionAsFileTypePressed",
    "export",
    "quickExport",
    "generateAssets",
    "saveForWeb",
    "print",
    "printOneCopy",
    "copyEvent",
    "copyMerged",
    "cut",
    "paste",
    "pasteInto",
    "pasteOutside",
    "batch",
    "multiGet"
  ],
  "classes": ["document", "layer", "channel", "path", "contentLayer", "adjustmentLayer"],
  "make_classes": ["layer", "channel", "path", "contentLayer", "adjustmentLayer"],
  "get_strip": ["_path", "fileReference", "XMPMetadataAsUTF8", "json", "fullName", "filePath"]
}
