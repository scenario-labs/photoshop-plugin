root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,json,css,html,yml,yaml,toml,sh}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Answers recorded from the live API, kept byte for byte.
[test/fixtures/**]
insert_final_newline = unset
trim_trailing_whitespace = false
